<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The recorder's isolation contract, enforced by macOS (App Sandbox).
  It holds audio and transcripts, so it gets NO network entitlement: no
  com.apple.security.network.client / network.server. verify.sh fails if either appears.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key><true/>
    <!-- Record the microphone. -->
    <key>com.apple.security.device.audio-input</key><true/>
    <!-- Read tab URLs to tell a Meet / Zoom web call apart from other browser audio. -->
    <key>com.apple.security.temporary-exception.apple-events</key>
    <array>
        <string>com.google.Chrome</string>
        <string>company.thebrowser.Browser</string>
        <string>com.microsoft.edgemac</string>
        <string>com.brave.Browser</string>
        <string>com.apple.Safari</string>
    </array>
    <!-- Read (never write) the invite metadata the calendar helper hands over. -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>/Library/Application Support/Eavesdropper Calendar/</string>
    </array>
</dict>
</plist>
